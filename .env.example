# Clica — variáveis de ambiente
#
# Copie para .env.local (dev) ou configure no painel da Vercel (produção).
# SEM estas variáveis, o app roda com o store EM MEMÓRIA (protótipo): tudo
# funciona, mas os dados somem quando o servidor reinicia. Com elas, os dados
# passam a persistir no Postgres/Storage do Supabase.

# URL do projeto Supabase (Project Settings → API → Project URL)
SUPABASE_URL=

# Chave service_role (Project Settings → API → service_role secret).
# É uma chave de servidor com acesso total — NUNCA exponha no cliente nem
# faça commit dela. Só é lida no servidor (API routes / server components).
SUPABASE_SERVICE_ROLE_KEY=
